{
  "name": "quantum-dagestan",
  "version": "0.1.0",
  "private": true,
  "description": "Платформа бизнес-сообществ и клубов (Quantum Dagestan SRS v1.0)",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @qd/api dev",
    "dev:web": "pnpm --filter @qd/web dev",
    "dev:mobile": "pnpm --filter @qd/mobile start",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @qd/api db:migrate",
    "db:generate": "pnpm --filter @qd/api db:generate",
    "db:studio": "pnpm --filter @qd/api db:studio",
    "db:seed": "pnpm --filter @qd/api db:seed",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.3",
      "@types/react-dom": "^18.3.0"
    }
  }
}
