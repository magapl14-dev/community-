# ─────────────────────────────────────────────────────────
# КОРНЕВЫЕ ПЕРЕМЕННЫЕ (для docker-compose и общих скриптов)
# Скопируй в .env и заполни. НЕ коммить .env в git.
# ─────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=qd
POSTGRES_PASSWORD=qd_dev_password
POSTGRES_DB=quantum_dagestan
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────
# API (packages/api) — также читается напрямую из packages/api/.env
# ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://qd:qd_dev_password@localhost:5432/quantum_dagestan?schema=public
REDIS_URL=redis://localhost:6379

# JWT — сгенерируй: openssl rand -base64 64
JWT_SECRET=change-me-in-production-min-64-chars-long
JWT_REFRESH_SECRET=change-me-too-different-from-jwt-secret

# Telegram Bot — @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=quantum_dag_bot
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ЮKassa — https://yookassa.ru/
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=

# Yandex Object Storage (S3-совместимое)
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=quantum-dagestan
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Unisender (email)
UNISENDER_API_KEY=

# Yandex SmartCaptcha (server-side validation key)
SMARTCAPTCHA_SERVER_KEY=

# Firebase Cloud Messaging (push)
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# Sentry
SENTRY_DSN=

# ─────────────────────────────────────────────────────────
# WEB (packages/web)
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=quantum_dag_bot
NEXT_PUBLIC_SMARTCAPTCHA_KEY=
# Sentry (web) — клиент использует NEXT_PUBLIC_; server берёт общий SENTRY_DSN сверху
NEXT_PUBLIC_SENTRY_DSN=
# Для build-time загрузки source-map'ов в Sentry (опционально)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────
# MOBILE (packages/mobile)
# ─────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=quantum_dag_bot
